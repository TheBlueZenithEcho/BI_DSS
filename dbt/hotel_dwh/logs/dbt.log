[0m23:23:57.261806 [debug] [Thread-1 (]: On model.hotel_dwh.clean_hotel_bookings: create or replace   view HOTEL_DWH.SILVER.clean_hotel_bookings
  
  
  
  
  as (
    -- Silver model: Clean hotel bookings data
-- This model builds proper dates, casts types, and preserves all original columns
-- It does NOT generate new raw_booking_id values; the ID is carried from Bronze.

WITH source AS (
    SELECT * FROM HOTEL_DWH.SILVER.stg_raw_hotel_bookings
)
SELECT
    -- Construct proper arrival_date from raw components
    TO_DATE(
        arrival_date_year || '-' || arrival_date_month || '-' || arrival_date_day_of_month,
        'YYYY-MONTH-DD'
    ) AS arrival_date,
    -- Compute departure_date using total nights (week + weekend)
    DATEADD(
        day,
        stays_in_week_nights + stays_in_weekend_nights,
        TO_DATE(
            arrival_date_year || '-' || arrival_date_month || '-' || arrival_date_day_of_month,
            'YYYY-MONTH-DD'
        )
    ) AS departure_date,
    -- Cast numeric/boolean fields to appropriate types
    CAST(adults AS INTEGER) AS adults,
    CAST(children AS INTEGER) AS children,
    CAST(babies AS INTEGER) AS babies,
    CAST(is_canceled AS BOOLEAN) AS is_canceled,
    CAST(is_repeated_guest AS BOOLEAN) AS is_repeated_guest,
    -- Preserve original columns (explicit list to avoid duplicate names)
    hotel,
    lead_time,
    arrival_date_year,
    arrival_date_month,
    arrival_date_week_number,
    arrival_date_day_of_month,
    stays_in_weekend_nights,
    stays_in_week_nights,
    meal,
    country,
    market_segment,
    distribution_channel,
    previous_cancellations,
    previous_bookings_not_canceled,
    reserved_room_type,
    assigned_room_type,
    booking_changes,
    deposit_type,
    agent,
    company,
    days_in_waiting_list,
    customer_type,
    adr,
    required_car_parking_spaces,
    total_of_special_requests,
    reservation_status,
    reservation_status_date,
    raw_booking_id
FROM source
WHERE arrival_date_year IS NOT NULL
  AND arrival_date_month IS NOT NULL
  AND arrival_date_day_of_month IS NOT NULL
  )
