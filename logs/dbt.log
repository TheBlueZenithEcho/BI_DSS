    ob_medium_risk_pct::number(8,3) as ob_medium_risk_pct,
    ob_high_risk_pct::number(8,3) as ob_high_risk_pct,
    7::integer as late_cancel_threshold_T,
    1.5::number(8,3) as compensation_multiplier
from policies
